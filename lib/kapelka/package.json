{
  "name": "kapelka",
  "version": "0.1.0",
  "description": "Zero-dependency, framework-free canvas charting engine — the render core of trading-vue-js. No build step required.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "main": "./index.js",
  "module": "./index.js",
  "exports": {
    ".": "./index.js",
    "./studies": "./studies/index.js",
    "./skin": "./skin/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "core/",
    "studies/",
    "skin/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "charts",
    "candlestick",
    "trading",
    "canvas",
    "financial",
    "trading-vue-js",
    "vanilla",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "PlainCharts",
  "repository": {
    "type": "git",
    "url": "https://github.com/PlainCharts/kapelka"
  },
  "homepage": "https://plaincharts.github.io/kapelka/examples/"
}
