---
import Base from '../layouts/Base.astro';
---

<Base title="Plain Charts — Documentation">
	<style>
		.hero { padding: 2rem 0 0.5rem; }
		.hero h1 { font-size: 2.6rem; font-weight: 600; margin-bottom: 1rem; letter-spacing: -0.02em; line-height: 1.15; }
		.hero p { color: #666; font-size: 1.3rem; line-height: 1.5; margin-bottom: 2.5rem; }
		.btn-docs {
			display: inline-flex; align-items: center; gap: 0.5rem; background: #000; color: #fff;
			padding: 0.7rem 1.3rem; font-size: 0.95rem; text-decoration: none; border-radius: 6px;
		}
		.btn-docs:hover { background: #333; color: #fff; }
	</style>

	<div class="hero">
		<h1>Modular trading platform built to be extended.</h1>
		<p>Build what you want on a foundation that stays out of your way.</p>
	</div>

	<a class="btn-docs" href="/start">Read the docs →</a>
</Base>
